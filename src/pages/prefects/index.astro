---
import Header from '../../components/Header.astro';

import { GraphQLClient } from 'graphql-request';
const endpoint = import.meta.env.HYGRAPH_ENDPOINT;

const client  = new GraphQLClient(endpoint);

const query = `
query {
  prefects {
    name
    position
    date
    certificateNumber
    photo {
      url
    }
  }
}`;

const data = await client.request(query);
---

<main>
		<Header />

        <h1>List of Prefects</h1>

        {data.prefects.map((prefect) => (
        <div>
            <h2>{prefect.name}</h2>
            <p><b>Position</b>: {prefect.position}</p>
            <p><b>Joined Date</b>: {prefect.date}</p>
            <p><b>Certificate Number</b>: {prefect.certificateNumber}</p>
            {prefect.photo && (
                <img src={prefect.photo.url} alt={prefect.name} width="150">
            )}
        </div>

                <button
          class="generate-btn"
          data-name={prefect.name}
          data-position={prefect.position}
          data-certificate-number={prefect.certificateNumber}
        >
          Generate PDF
        </button>
        ))}
</main>

<script>
  import {
    PDFDocument,
    StandardFonts,
    rgb
  } from "pdf-lib";

  const buttons = document.querySelectorAll(".generate-btn");

  buttons.forEach((button) => {
    button.addEventListener("click", async () => {
      const name =
        button.getAttribute("data-name") || "";

      const position =
        button.getAttribute("data-position") || "";

      const certificateNumber =
        button.getAttribute("data-certificate-number") || "";

      // Find the photo from the prefect card
      const prefectCard = button.closest(".prefect");

      const photoElement =
        prefectCard?.querySelector("img");

      const photoUrl =
        photoElement?.getAttribute("src");

      try {
        // --------------------------------
        // LOAD CERTIFICATE TEMPLATE
        // --------------------------------

        const response = await fetch(
          "/certificate-template.pdf"
        );

        const templateBytes =
          await response.arrayBuffer();

        const pdfDoc =
          await PDFDocument.load(templateBytes);

        const page =
          pdfDoc.getPages()[0];

        // --------------------------------
        // FONT
        // --------------------------------

        const font =
          await pdfDoc.embedFont(
            StandardFonts.Helvetica
          );

        const pageWidth =
          page.getWidth();

        const pageHeight =
          page.getHeight();

        // --------------------------------
        // NAME
        // --------------------------------

        const nameSize = 28;

        const nameWidth =
          font.widthOfTextAtSize(
            name,
            nameSize
          );

        page.drawText(name, {
          x: (pageWidth - nameWidth) / 2,
          y: pageHeight / 2,
          size: nameSize,
          font,
          color: rgb(0, 0, 0),
        });

        // --------------------------------
        // POSITION
        // --------------------------------

        const positionText =
          position.replaceAll("_", " ");

        const positionSize = 16;

        const positionWidth =
          font.widthOfTextAtSize(
            positionText,
            positionSize
          );

        page.drawText(positionText, {
          x: (pageWidth - positionWidth) / 2,
          y: pageHeight / 2 - 40,
          size: positionSize,
          font,
          color: rgb(0, 0, 0),
        });

        // --------------------------------
        // DATE
        // --------------------------------

        page.drawText(certificateNumber, {
          x: 435,
          y: 50,
          size: 12,
          font,
          color: rgb(0, 0, 0),
        });


        // --------------------------------
        // PHOTO
        // --------------------------------

        if (photoUrl) {
          const photoResponse =
            await fetch(photoUrl);

          const photoBytes =
            await photoResponse.arrayBuffer();

          let photo;

          const contentType =
            photoResponse.headers.get(
              "content-type"
            );

          if (
            contentType?.includes("png")
          ) {
            photo =
              await pdfDoc.embedPng(
                photoBytes
              );
          } else {
            photo =
              await pdfDoc.embedJpg(
                photoBytes
              );
          }

          // Temporary photo size
          const photoWidth = 120;
          const photoHeight = 150;

          // Temporary centered position
          const photoX =
            (pageWidth - photoWidth) / 2;

          const photoY =
            pageHeight / 2 - 220;

          page.drawImage(photo, {
            x: photoX,
            y: photoY,
            width: photoWidth,
            height: photoHeight,
          });
        }

        // --------------------------------
        // SAVE PDF
        // --------------------------------

        const pdfBytes =
          await pdfDoc.save();

        const blob =
          new Blob(
            [pdfBytes],
            {
              type: "application/pdf"
            }
          );

        const url =
          URL.createObjectURL(blob);

        const link =
          document.createElement("a");

        link.href = url;

        link.download =
          `${name}-certificate.pdf`;

        link.click();

        URL.revokeObjectURL(url);

      } catch (error) {
        console.error(error);

        alert(
          "Failed to generate certificate."
        );
      }
    });
  });
</script>